# ---- Core ----
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sawt_aljazair
# Must be >= 32 characters in production
JWT_SECRET=change-this-secret-to-a-long-random-string-0123456789
CORS_ORIGIN=*
PUBLIC_BASE_URL=http://localhost:4000
# true only when DATABASE_URL is a database dedicated to Sawt Aljazair (runs prisma db push on start)
DEDICATED_DATABASE=true

# ---- Administrators ----
# Any account registered with one of these emails becomes ADMIN automatically (comma separated)
ADMIN_EMAILS=
# Optional: create the first admin account on startup
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_NAME=Administrator

# ---- Media storage ----
# auto  = R2/S3 if configured, otherwise PostgreSQL (production) or ./uploads (development)
# s3 | db | local to force a mode
STORAGE_MODE=auto
MAX_UPLOAD_BYTES=52428800
DB_MEDIA_MAX_BYTES=41943040
# Optional S3-compatible storage / Cloudflare R2 (recommended for production videos)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ---- Email (password reset codes) - optional ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Push notifications when the app is closed - optional ----
# Run `npm i firebase-admin`, then paste the service-account JSON (or its base64) here
FIREBASE_SERVICE_ACCOUNT=

# ---- Optional one-time test account ----
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_USERNAME=sawt_test_2026
TEST_ACCOUNT_NAME=Sawt Aljazair Test
TEST_ACCOUNT_WILAYA=وهران
